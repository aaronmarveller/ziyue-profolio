ADMIN_PASSWORD_HASH=   # bcrypt hash — generate with: node scripts/hash-password.js yourpassword
JWT_SECRET=            # random 32-char hex — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN=          # fine-grained GitHub PAT (Contents: read+write on this repo only)
GITHUB_REPO=           # yourGitHubUsername/ziyue-profolio
RESEND_API_KEY=        # from resend.com (free tier)
CONTACT_EMAIL=         # email address where contact form messages should be sent
VIDEO_ONLY_MODE=       # set to `true` to narrow the whole public site to the /video/ai-english-learning demo page (home, research, publications, and contact all redirect there). Unset or any other value keeps the full portfolio visible (default). /admin and /api routes are never affected.
